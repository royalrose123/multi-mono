{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalPassThroughEnv": ["NEXT_TELEMETRY_DISABLED"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["INVOICE_ZONE_URL", "BUILD_STANDALONE"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", "public/menu-runtime/**"]
    },
    "dev": { "cache": false, "persistent": true },
    "menu-runtime:watch": { "cache": false, "persistent": true },
    "test": { "outputs": [] },
    "typecheck": { "outputs": [] }
  }
}
